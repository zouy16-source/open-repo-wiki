# OpenRepoWiki Frontend Environment Variables
# Copy this file to .env.local for local development
# or .env.production for production builds

# API Gateway URL - Set this to your deployed API Gateway invoke URL
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/v1
VITE_API_URL=

# For local development with the LocalStack backend (served at the root, no /api):
# VITE_API_URL=http://localhost:8000

# Source host for the breadcrumb repo links. Defaults to https://github.com.
# Set this for GitLab / self-hosted, e.g. https://git.your-company.com
# VITE_SOURCE_WEB_URL=https://gitlab.com
