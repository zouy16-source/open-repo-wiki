# Copy to local/.env.local and fill in. Used by the `processor` service.
#
#   cp local/.env.local.example local/.env.local
#
# Do NOT put real secrets in this file — it is a tracked template.
# local/.env.local is git-ignored; put your real tokens/keys there.

# ---- Source provider: where to read the repository from ----
# REPO_PROVIDER=github | gitlab   (default: github)
REPO_PROVIDER=github

# GitHub: personal access token (private repos need scope "repo").
GITHUB_TOKEN=

# GitLab: personal/project access token (scopes: read_api, read_repository).
# Works for private repos. For self-hosted GitLab, also set GITLAB_URL.
GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com

# ---- LLM (optional). If unset, the tree is built but AI summaries are skipped. ----
LLM_PROVIDER=deepseek
LLM_APIKEY=
LLM_MODELNAME=deepseek-v4-flash

# Output language for generated summaries: zh (default) | en
# OUTPUT_LANGUAGE=zh

# Optional: cap how many files get summarized (controls cost). Default 1000.
# MAX_FILE_LIMIT=200
